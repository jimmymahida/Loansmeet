NODE_ENV=production
PORT=3000
ADMIN_USERNAME=loansmeet_admin
ADMIN_PASSWORD=replace-with-a-strong-unique-password-at-least-16-chars
ADMIN_2FA_CODE=replace-with-a-separate-secret-code

# Persistent document storage: mount a persistent disk and point this at it.
DOCUMENT_STORAGE_DIR=/var/data/loansmeet/uploads

# Email (SendGrid)
SENDGRID_API_KEY=
NOTIFY_FROM_EMAIL=

# SMS (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# WhatsApp Cloud API
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
